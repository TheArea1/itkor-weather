{
  "info": { "name": "ITKOR Service API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "equipmentId", "value": "" },
    { "key": "requestId", "value": "" },
    { "key": "siteId", "value": "" },
    { "key": "technicianId", "value": "" }
  ],
  "item": [
    {
      "name": "Legacy Case 2",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.have.nested.property('data.status', 'ok');"] } }] },
        { "name": "Create equipment", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Инвертор №1\",\n  \"type\": \"inverter\",\n  \"serialNumber\": \"INV-{{$timestamp}}\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.62 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2024-01-10\"\n}" }, "url": "{{baseUrl}}/api/equipment" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('equipmentId', pm.response.json().data.id);"] } }] },
        { "name": "List equipment", "request": { "method": "GET", "url": "{{baseUrl}}/api/equipment?type=inverter&page=1&limit=10" } },
        { "name": "Get equipment", "request": { "method": "GET", "url": "{{baseUrl}}/api/equipment/{{equipmentId}}" } },
        { "name": "Update equipment", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"maintenance\"}" }, "url": "{{baseUrl}}/api/equipment/{{equipmentId}}" } },
        { "name": "Equipment weather", "request": { "method": "GET", "url": "{{baseUrl}}/api/equipment/{{equipmentId}}/weather" } },
        { "name": "Equipment requests", "request": { "method": "GET", "url": "{{baseUrl}}/api/equipment/{{equipmentId}}/requests" } },
        { "name": "Create request", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"equipmentId\":\"{{equipmentId}}\",\"title\":\"Плановая диагностика\",\"description\":\"Проверить оборудование\",\"priority\":\"high\"}" }, "url": "{{baseUrl}}/api/requests" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('requestId', pm.response.json().data.id);"] } }] },
        { "name": "List requests", "request": { "method": "GET", "url": "{{baseUrl}}/api/requests?priority=high" } },
        { "name": "Get request", "request": { "method": "GET", "url": "{{baseUrl}}/api/requests/{{requestId}}" } },
        { "name": "Update request", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"priority\":\"critical\"}" }, "url": "{{baseUrl}}/api/requests/{{requestId}}" } },
        { "name": "Change request status", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"in_progress\"}" }, "url": "{{baseUrl}}/api/requests/{{requestId}}/status" } },
        { "name": "Delete request", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/requests/{{requestId}}" } }
      ]
    },
    {
      "name": "PostgreSQL extensions",
      "item": [
        { "name": "Assign team", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"assignees\":[{\"technicianId\":\"{{technicianId}}\",\"role\":\"lead\",\"hours\":4}]}" }, "url": "{{baseUrl}}/api/requests/{{requestId}}/assignees" } },
        { "name": "Remove assignee", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/requests/{{requestId}}/assignees/{{technicianId}}" } },
        { "name": "Request history", "request": { "method": "GET", "url": "{{baseUrl}}/api/requests/{{requestId}}/history" } },
        { "name": "Site summary", "request": { "method": "GET", "url": "{{baseUrl}}/api/sites/{{siteId}}/summary" } },
        { "name": "Equipment load", "request": { "method": "GET", "url": "{{baseUrl}}/api/reports/equipment-load?dateFrom=2025-01-01&dateTo=2025-12-31&minRequests=1" } },
        { "name": "Team validation 422", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"assignees\":[]}" }, "url": "{{baseUrl}}/api/requests/{{requestId}}/assignees" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 422', () => pm.response.to.have.status(422));"] } }] },
        { "name": "Report sort injection 422", "request": { "method": "GET", "url": "{{baseUrl}}/api/reports/equipment-load?sortBy=serial_number;DROP%20TABLE%20equipment" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 422', () => pm.response.to.have.status(422));"] } }] }
      ]
    }
  ]
}
