{
  "info": {
    "name": "ITKOR PostgreSQL Extensions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "requestId", "value": "" },
    { "key": "siteId", "value": "" },
    { "key": "technicianId", "value": "" }
  ],
  "item": [
    {
      "name": "Request team",
      "item": [
        {
          "name": "Assign team",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"assignees\": [\n    { \"technicianId\": \"{{technicianId}}\", \"role\": \"lead\", \"hours\": 4 }\n  ]\n}" },
            "url": "{{baseUrl}}/api/requests/{{requestId}}/assignees"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Assign invalid team (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"assignees\":[]}" },
            "url": "{{baseUrl}}/api/requests/{{requestId}}/assignees"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 422', () => pm.response.to.have.status(422));"] } }]
        },
        { "name": "Remove assignee", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/requests/{{requestId}}/assignees/{{technicianId}}" } },
        { "name": "Request status history", "request": { "method": "GET", "url": "{{baseUrl}}/api/requests/{{requestId}}/history" } }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        { "name": "Site summary", "request": { "method": "GET", "url": "{{baseUrl}}/api/sites/{{siteId}}/summary" } },
        { "name": "Equipment load", "request": { "method": "GET", "url": "{{baseUrl}}/api/reports/equipment-load?dateFrom=2025-01-01&dateTo=2025-12-31&minRequests=1" } },
        {
          "name": "Reject report sort injection (422)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/reports/equipment-load?sortBy=serial_number;DROP%20TABLE%20equipment" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 422', () => pm.response.to.have.status(422));"] } }]
        }
      ]
    }
  ]
}
